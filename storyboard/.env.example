# Sao chép file này thành .env rồi điền API key cho backend TTS bạn dùng.
# CHỈ cần key của backend bạn chọn trong kịch bản (tts.backend).
# edge và gtts KHÔNG cần key.

# OpenAI TTS  (tts.backend = "openai")
OPENAI_API_KEY=

# ElevenLabs  (tts.backend = "elevenlabs")
ELEVENLABS_API_KEY=

# Azure Speech  (tts.backend = "azure") - cần thêm region
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
